# app
PORT=3000
NODE_ENV=development
APP_NAME=Nexus

# database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nexus
# Prefer DB_* fields. If using DATABASE_URL, encode special chars (e.g. @ -> %40).

# JWT
JWT_SECRET=nexus-dev-secret-change-me
JWT_EXPIRES_IN=7d

# frontend
FRONTEND_ORIGIN=http://localhost:4200
NEXUS_FRONTEND_URL=http://localhost:4200

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nexus/products

# SMTP (password reset OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set SMTP_SECURE=true when using port 465
SMTP_SECURE=false

# OpenAI Chatbot AI Assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

